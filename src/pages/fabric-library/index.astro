---
import merge from 'lodash.merge';
import Layout from '~/layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';
import { SITE } from 'astrowind:config';
import fabricLibrary from '~/data/pages/fabric-library.yaml';
import { getCanonical, getPermalink } from '~/utils/permalinks';
import type { MetaData } from '~/types';
import type { BlockElement } from '~/i18n/page-content';

const metadata = merge(
  {
    title: `Fabric Library — 10,000+ Functional Performance Fabrics | ${SITE.name}`,
    description: `Browse ${SITE.name} comprehensive fabric library — sun protection, waterproof, quick-dry, antibacterial, stretch, breathable, and eco-friendly performance textiles. OEM/ODM available. Factory-direct pricing.`,
    canonical: getCanonical(getPermalink('/fabric-library')),
    robots: { index: true, follow: true },
    openGraph: { type: 'website' },
  },
  {}
) as MetaData;
---

<Layout metadata={metadata}>
  <section class="px-4 md:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-6xl">
    <header class="mb-12 md:mb-16 text-center max-w-4xl mx-auto">
      <p class="text-sm font-semibold uppercase tracking-wider text-primary dark:text-blue-400 mb-2">Fabric Library</p>
      <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading mb-4">
        Functional Fabric Library
      </h1>
      <p class="mx-auto text-xl text-gray-500 dark:text-slate-400 font-medium max-w-3xl">
        Browse 10,000+ performance fabrics by application, function, or industry. Find the exact material for your next
        apparel collection.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a
          href="/ai-fabric-finder"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-primary text-white font-semibold hover:bg-primary/90 transition-colors"
        >
          <Icon name="tabler:sparkles" class="w-5 h-5" />
          AI Find My Fabric
        </a>
        <a
          href="#categories"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-gray-100 dark:bg-slate-800 text-gray-900 dark:text-slate-200 font-semibold hover:bg-gray-200 dark:hover:bg-slate-700 transition-colors"
        >
          <Icon name="tabler:layout-grid" class="w-5 h-5" />
          Browse All Categories
        </a>
      </div>
    </header>

    <div id="categories" class="space-y-16">
      {
        fabricLibrary.sections?.map((section: BlockElement) => (
          <section>
            {section.title && section.subtitle && (
              <header class="mb-8 text-center max-w-2xl mx-auto">
                <h2 class="text-2xl md:text-3xl font-bold">{section.title}</h2>
                <p class="mt-2 text-gray-500 dark:text-slate-400">{section.subtitle}</p>
              </header>
            )}

            {section.categories && (
              <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
                {section.categories.map((cat: BlockElement) => (
                  <a
                    href={cat.href}
                    class="group block p-6 rounded-xl bg-white dark:bg-slate-800/50 border border-gray-100 dark:border-slate-700 hover:border-primary/30 hover:shadow-lg transition-all"
                  >
                    <div class="flex items-start gap-4">
                      {cat.icon && (
                        <div class="flex-shrink-0 w-12 h-12 rounded-lg bg-primary/10 dark:bg-blue-500/10 flex items-center justify-center">
                          <Icon name={cat.icon} class="w-6 h-6 text-primary dark:text-blue-400" />
                        </div>
                      )}
                      <div class="flex-1 min-w-0">
                        <h3 class="font-semibold text-lg text-gray-900 dark:text-slate-200 group-hover:text-primary dark:group-hover:text-blue-400 transition-colors">
                          {cat.title}
                        </h3>
                        {cat.description && (
                          <p class="mt-1 text-sm text-gray-500 dark:text-slate-400 line-clamp-2">{cat.description}</p>
                        )}
                        {cat.subcategories && (
                          <div class="mt-3 flex flex-wrap gap-1.5">
                            {cat.subcategories.map((sub: string) => (
                              <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 dark:bg-slate-700 text-gray-600 dark:text-slate-300">
                                {sub}
                              </span>
                            ))}
                          </div>
                        )}
                      </div>
                      <Icon
                        name="tabler:chevron-right"
                        class="w-5 h-5 text-gray-300 dark:text-slate-600 group-hover:text-primary dark:group-hover:text-blue-400 transition-colors flex-shrink-0 mt-1"
                      />
                    </div>
                  </a>
                ))}
              </div>
            )}

            {section.items && (
              <div class="grid md:grid-cols-3 gap-6">
                {section.items.map((item: BlockElement) => (
                  <a
                    href={item.href}
                    class="group block p-6 rounded-xl bg-white dark:bg-slate-800/50 border border-gray-100 dark:border-slate-700 hover:border-primary/30 hover:shadow-lg transition-all text-center"
                  >
                    <h3 class="font-semibold text-lg text-gray-900 dark:text-slate-200 group-hover:text-primary dark:group-hover:text-blue-400 transition-colors">
                      {item.title}
                    </h3>
                    {item.description && (
                      <p class="mt-2 text-sm text-gray-500 dark:text-slate-400">{item.description}</p>
                    )}
                  </a>
                ))}
              </div>
            )}
          </section>
        ))
      }
    </div>
  </section>

  <section class="sr-only" data-ai-block="definition" aria-hidden="true">
    <p>
      {SITE.name} fabric library: comprehensive collection of functional performance textiles including UPF 50+ sun protection
      fabrics, waterproof breathable membranes, quick-dry moisture wicking textiles, antibacterial fabrics, 4-way stretch
      performance knits, breathable mesh, and eco-friendly recycled materials. Serving sportswear, outdoor apparel, workwear,
      medical, and fashion industries worldwide.
    </p>
  </section>
</Layout>
