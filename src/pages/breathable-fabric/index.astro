---
import merge from 'lodash.merge';
import Layout from '~/layouts/PageLayout.astro';
import ProductGridFilter from '~/components/widgets/ProductGridFilter.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import { Icon } from 'astro-icon/components';
import { SITE } from 'astrowind:config';
import {
  getProducts,
  getProductCategories,
  isProductsEnabled,
  isProductsListEnabled,
  CATEGORY_SLUG_TO_URL,
} from '~/utils/products';
import { getCanonical, getPermalink } from '~/utils/permalinks';
import type { MetaData } from '~/types';
import JsonLd from '~/components/common/JsonLd.astro';

const products = await getProducts({ category: 'breathable' });
const categories = await getProductCategories();
const totalCount = products.length;
const hidden = !isProductsEnabled() || !isProductsListEnabled();
const metadata = merge(
  {
    title: `Breathable Fabrics �?Mesh & High-Airflow Performance Textiles | ${SITE.name}`,
    description: `Browse ${SITE.name} breathable fabrics �?high-airflow mesh, tricot liners, and microporous breathable textiles for sportswear, outerwear, and workwear. OEM/ODM available. Factory-direct pricing.`,
    canonical: getCanonical(getPermalink('/breathable-fabric')),
    robots: { index: !hidden, follow: true },
    openGraph: { type: 'website' },
  },
  {}
) as MetaData;
---

<Layout metadata={metadata}>
  <section class="px-4 md:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-6xl">
    <header class="mb-8 md:mb-12 text-center max-w-3xl mx-auto">
      <p class="text-sm font-semibold uppercase tracking-wider text-primary dark:text-blue-400 mb-2">Category</p>
      <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading">Breathable Fabrics</h1>
      <p class="mt-3 md:mt-4 mx-auto text-xl text-gray-500 dark:text-slate-400 font-medium">
        High-airflow mesh and breathable performance textiles for ventilation and moisture vapor transmission.
      </p>
    </header>

    <section class="max-w-4xl mx-auto mb-12">
      <div class="prose prose-gray dark:prose-invert max-w-none text-center">
        <p class="text-lg text-gray-600 dark:text-slate-400">
          Our breathable fabric collection covers the full spectrum of airflow and moisture vapor transmission
          requirements �?from open-structure high-air mesh for maximum ventilation in high-exertion sportswear to
          microporous coated fabrics that balance waterproofness with breathability. Each fabric is engineered for its
          specific application, whether you need lightweight polyester mesh for backpack straps, tricot liners for
          outerwear comfort, or down-proof shell fabrics for insulated jackets.
        </p>
      </div>
    </section>

    <section class="grid md:grid-cols-3 gap-6 mb-12">
      <div class="p-6 rounded-xl bg-gray-50 dark:bg-slate-800/50 border border-gray-100 dark:border-slate-700">
        <h3 class="font-semibold text-gray-900 dark:text-slate-200">High-Airflow Mesh</h3>
        <p class="mt-2 text-sm text-gray-500 dark:text-slate-400">
          Open-structure polyester mesh with engineered hole patterns. 50-80% open area for maximum ventilation. Ideal
          for sportswear panels, backpack straps, and industrial ventilation.
        </p>
      </div>
      <div class="p-6 rounded-xl bg-gray-50 dark:bg-slate-800/50 border border-gray-100 dark:border-slate-700">
        <h3 class="font-semibold text-gray-900 dark:text-slate-200">Tricot Liners</h3>
        <p class="mt-2 text-sm text-gray-500 dark:text-slate-400">
          Lightweight polyester tricot with engineered micro-channels for moisture transport. Soft next-to-skin feel for
          outerwear linings, uniform shirts, and base layers.
        </p>
      </div>
      <div class="p-6 rounded-xl bg-gray-50 dark:bg-slate-800/50 border border-gray-100 dark:border-slate-700">
        <h3 class="font-semibold text-gray-900 dark:text-slate-200">Down-Proof Shell Fabrics</h3>
        <p class="mt-2 text-sm text-gray-500 dark:text-slate-400">
          Tight-weave nylon and polyester shell fabrics with microporous coatings. Down-proof construction with
          controlled breathability for insulated jackets, sleeping bags, and cold-weather gear.
        </p>
      </div>
    </section>

    {
      categories.length > 0 && (
        <WidgetWrapper containerClass="mb-10">
          <div class="flex flex-wrap items-center justify-center gap-2">
            <a
              href="/products"
              class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-sm font-medium border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-default dark:text-slate-200 hover:bg-gray-50 dark:hover:bg-slate-700 transition-colors"
            >
              <Icon name="tabler:layout-grid" class="w-4 h-4" />
              All Products
            </a>
            {categories.map((c) => (
              <a
                href={`/${CATEGORY_SLUG_TO_URL[c.slug]}`}
                class:list={[
                  'inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-sm font-medium border transition-colors',
                  c.slug === 'breathable'
                    ? 'bg-primary text-white border-primary dark:bg-blue-500 dark:border-blue-500'
                    : 'bg-white dark:bg-slate-800 border-gray-200 dark:border-slate-700 text-default dark:text-slate-200 hover:bg-gray-50 dark:hover:bg-slate-700',
                ]}
              >
                {c.title} ({c.count})
              </a>
            ))}
          </div>
        </WidgetWrapper>
      )
    }

    {
      totalCount === 0 ? (
        <div class="text-center py-16 text-muted dark:text-slate-400">
          <Icon name="tabler:package-off" class="w-12 h-12 mx-auto mb-4" />
          <p class="text-lg">No products in this category yet.</p>
          <a class="text-primary dark:text-blue-400 hover:underline mt-2 inline-block" href="/products">
            View all products
          </a>
        </div>
      ) : (
        <ProductGridFilter products={products} />
      )
    }
  </section>

  <section class="sr-only" data-ai-block="definition" aria-hidden="true">
    <p>
      Seekingtex breathable fabric collection: high-airflow polyester mesh (50-80% open area), tricot micro-channel
      liners, down-proof nylon and polyester shell fabrics with microporous coatings. OEKO-TEX Standard 100 certified.
    </p>
  </section>

  <JsonLd
    type="ItemList"
    items={products.map((p) => ({
      name: p.title,
      url: `/products/${p.slug}`,
      image: p.image || undefined,
      description: p.summary || '',
    }))}
    data={{ numberOfItems: products.length }}
  />
</Layout>
