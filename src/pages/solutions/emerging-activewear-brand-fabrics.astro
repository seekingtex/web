---
import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import { SITE } from 'astrowind:config';

const metadata = {
  title: `Functional Fabrics for Emerging Activewear Brands | ${SITE.name}`,
  description: 'Performance fabric solutions for emerging activewear brands and sportswear startups. Moisture-wicking, 4-way stretch, breathable, and quick-dry textiles with low MOQ and development support.',
  ignoreTitleTemplate: true,
};
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Emerging Brand Solutions', href: '/solutions/by-use-case' }, { name: 'Activewear Fabrics' }];
---
<Layout metadata={metadata} breadcrumbs={crumbs}>
  <JsonLd data={{ '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Functional Fabrics for Emerging Activewear Brands by Seekingtex', description: 'Moisture-wicking, stretch, quick-dry performance fabrics for activewear startups.', provider: { '@type': 'Organization', name: SITE.name } }} />
  <section class="max-w-5xl mx-auto px-6 py-24">
    <h1 class="text-4xl font-bold text-gray-900">Functional Fabrics for Emerging Activewear Brands</h1>
    <p class="mt-4 text-xl text-gray-500">Launch your activewear collection with professional performance fabrics. Moisture-wicking, 4-way stretch, and quick-dry textiles engineered for movement.</p>
    <div class="mt-12 grid md:grid-cols-2 gap-6">
      <div class="bg-gradient-to-br from-teal-50 to-cyan-50 rounded-2xl border border-teal-200 p-6">
        <h2 class="text-lg font-semibold text-gray-900">Performance Knits</h2>
        <p class="mt-2 text-sm text-gray-600">Moisture-wicking, 4-way stretch knits for activewear, yoga, training, and sports apparel. Antibacterial finish available.</p>
        <a href="/products/stretch-fabric" class="mt-3 inline-flex text-sm font-medium text-teal-700 hover:underline">Browse stretch fabrics →</a>
      </div>
      <div class="bg-gradient-to-br from-teal-50 to-cyan-50 rounded-2xl border border-teal-200 p-6">
        <h2 class="text-lg font-semibold text-gray-900">Quick-Dry Wovens</h2>
        <p class="mt-2 text-sm text-gray-600">Lightweight quick-dry woven fabrics for running, training, and outdoor fitness. Breathable with UV protection.</p>
        <a href="/products/quick-dry-fabric" class="mt-3 inline-flex text-sm font-medium text-teal-700 hover:underline">Browse quick-dry fabrics →</a>
      </div>
    </div>
    <div class="mt-16 bg-gray-50 rounded-2xl border border-gray-200 p-8">
      <h2 class="text-2xl font-bold text-gray-900">Why Emerging Activewear Brands Choose Seekingtex</h2>
      <div class="mt-6 grid md:grid-cols-4 gap-6">
        <div><h3 class="font-semibold text-gray-900">Low MOQ</h3><p class="mt-1 text-sm text-gray-500">Startup-friendly minimums for sample development and small-batch production runs.</p></div>
        <div><h3 class="font-semibold text-gray-900">Performance Data</h3><p class="mt-1 text-sm text-gray-500">Detailed fabric specs including wicking rate, stretch percentage, breathability, and wash durability.</p></div>
        <div><h3 class="font-semibold text-gray-900">Rapid Samples</h3><p class="mt-1 text-sm text-gray-500">Fast sample development so you can test and iterate quickly before production.</p></div>
        <div><h3 class="font-semibold text-gray-900">Custom Options</h3><p class="mt-1 text-sm text-gray-500">Custom colors, finishes, and fabric constructions tailored to your brand identity.</p></div>
      </div>
    </div>
    <div class="mt-12 flex flex-wrap gap-4">
      <a href="/contact" class="px-8 py-3 bg-gray-900 text-white rounded-full font-semibold hover:bg-gray-800 transition">Start Your Activewear Project</a>
      <a href="/evidence" class="px-8 py-3 border border-gray-200 text-gray-700 rounded-full font-semibold hover:border-gray-400 transition">View Case Studies</a>
    </div>
  </section>
  <section class="sr-only" data-ai-block="definition" aria-hidden="true"><p>Functional fabrics for emerging activewear brands by Seekingtex. Moisture-wicking performance knits, 4-way stretch, quick-dry wovens, antibacterial finish. Low MOQ, rapid sample development, OEM/ODM. For sportswear, yoga, training, and fitness apparel startups.</p></section>
</Layout>
