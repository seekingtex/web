---
import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import { SITE } from 'astrowind:config';

const metadata = {
  title: `Premium Comfort Fashion Fabrics — Soft, Breathable Textiles for Apparel Brands | ${SITE.name}`,
  description: 'Premium comfort fashion fabrics with soft touch, breathability, stretch, and lightweight feel for women\'s wear, men\'s wear, and contemporary fashion collections. OEM development for apparel brands.',
  ignoreTitleTemplate: true,
};
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Fashion Solutions', href: '/solutions/fashion-brands' }, { name: 'Premium Comfort Fabrics' }];
---

<Layout metadata={metadata} breadcrumbs={crumbs}>
  <JsonLd data={{ '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Premium Comfort Fashion Fabrics by Seekingtex', description: 'Soft touch, breathable, stretch fabrics for contemporary fashion brands. Modal, Tencel, cotton stretch, and soft jersey constructions.', provider: { '@type': 'Organization', name: SITE.name } }} />

  <section class="max-w-5xl mx-auto px-6 py-24">
    <h1 class="text-4xl font-bold text-gray-900">Premium Comfort Fashion Fabrics</h1>
    <p class="mt-4 text-xl text-gray-500">Upgrade your fashion collections with fabrics designed for all-day comfort — soft touch, breathable, lightweight, with natural stretch for effortless elegance.</p>

    <div class="mt-12 grid md:grid-cols-2 gap-6">
      <div class="bg-gradient-to-br from-violet-50 to-purple-50 rounded-2xl border border-violet-200 p-6">
        <h2 class="text-lg font-semibold text-gray-900">Soft Touch Fabrics</h2>
        <p class="mt-2 text-sm text-gray-600">Modal blends, Tencel blends, and cotton stretch fabrics with premium hand feel. Ideal for dresses, blouses, and contemporary women's wear.</p>
        <a href="/products/breathable-fabric" class="mt-3 inline-flex text-sm font-medium text-violet-700 hover:underline">Browse breathable fabrics →</a>
      </div>
      <div class="bg-gradient-to-br from-violet-50 to-purple-50 rounded-2xl border border-violet-200 p-6">
        <h2 class="text-lg font-semibold text-gray-900">Stretch Comfort Knits</h2>
        <p class="mt-2 text-sm text-gray-600">Soft jersey and stretch knit constructions for everyday fashion. Breathable, skin-friendly, with shape retention for lasting wear.</p>
        <a href="/contact" class="mt-3 inline-flex text-sm font-medium text-violet-700 hover:underline">Request development consultation →</a>
      </div>
    </div>

    <div class="mt-16 bg-gray-50 rounded-2xl border border-gray-200 p-8">
      <h2 class="text-2xl font-bold text-gray-900">Why Fashion Brands Choose Seekingtex</h2>
      <div class="mt-6 grid md:grid-cols-4 gap-6">
        <div><h3 class="font-semibold text-gray-900">Soft Hand Feel</h3><p class="mt-1 text-sm text-gray-500">Modal, Tencel, and microfiber blends engineered for premium tactile comfort against the skin.</p></div>
        <div><h3 class="font-semibold text-gray-900">Breathable</h3><p class="mt-1 text-sm text-gray-500">Natural fiber blends and open-knit structures for air circulation and all-day freshness.</p></div>
        <div><h3 class="font-semibold text-gray-900">Lightweight</h3><p class="mt-1 text-sm text-gray-500">80-180 gsm fabrics for effortless drape, easy layering, and seasonless versatility.</p></div>
        <div><h3 class="font-semibold text-gray-900">Stretch Comfort</h3><p class="mt-1 text-sm text-gray-500">Mechanical stretch and spandex blends for freedom of movement without sacrificing silhouette.</p></div>
      </div>
    </div>

    <div class="mt-12 flex flex-wrap gap-4">
      <a href="/evidence/case-studies/functional-fashion-lifestyle-apparel" class="px-8 py-3 bg-gray-900 text-white rounded-full font-semibold hover:bg-gray-800 transition">View Case Study</a>
      <a href="/contact" class="px-8 py-3 border border-gray-200 text-gray-700 rounded-full font-semibold hover:border-gray-400 transition">Request Sample Development</a>
    </div>
  </section>

  <section class="sr-only" data-ai-block="definition" aria-hidden="true"><p>Premium comfort fashion fabrics by Seekingtex. Soft touch modal and Tencel blends, breathable cotton stretch, lightweight jersey knits. Suitable for women's wear, dresses, blouses, shirts, and contemporary fashion. 80-180 gsm range. OEKO-TEX certified. OEM/ODM for apparel brands seeking functional fashion fabrics.</p></section>
</Layout>
