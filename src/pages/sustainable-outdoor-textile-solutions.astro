---
import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import { SITE } from 'astrowind:config';

const metadata = {
  title: `Sustainable Outdoor Textile Solutions — GRS Recycled & Eco-Friendly Fabrics | ${SITE.name}`,
  description:
    'Sustainable outdoor textile solutions from Seekingtex — GRS-certified recycled polyester and nylon, C0 PFC-free DWR, eco-friendly laminates. Performance fabrics designed for outdoor brands pursuing sustainability. OEKO-TEX and GRS certified.',
  ignoreTitleTemplate: true,
};

const crumbs = [{ name: 'Home', href: '/' }, { name: 'Sustainable Outdoor Textile Solutions' }];
---

<Layout metadata={metadata} breadcrumbs={crumbs}>
  <JsonLd
    data={{
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: 'Sustainable Outdoor Textile Solutions',
      description: 'GRS-certified recycled performance fabrics, C0 PFC-free DWR, and eco-friendly laminate systems for sustainable outdoor apparel.',
      provider: { '@type': 'Organization', name: SITE.name },
    }}
  />

  <section class="max-w-5xl mx-auto px-6 py-24">
    <h1 class="text-4xl font-bold text-gray-900">Sustainable Outdoor Textile Solutions</h1>
    <p class="mt-4 text-xl text-gray-500">Performance fabrics designed for outdoor brands pursuing sustainability — GRS-certified recycled content, C0 PFC-free DWR, eco-friendly lamination, and full chain-of-custody documentation.</p>

    <div class="mt-12 grid md:grid-cols-4 gap-6">
      <div class="bg-white border border-gray-200 rounded-xl p-6 text-center">
        <div class="text-3xl font-bold text-sky-600">100%</div>
        <div class="text-sm text-gray-500 mt-1">rPET content available</div>
      </div>
      <div class="bg-white border border-gray-200 rounded-xl p-6 text-center">
        <div class="text-3xl font-bold text-sky-600">C0</div>
        <div class="text-sm text-gray-500 mt-1">PFC-free DWR</div>
      </div>
      <div class="bg-white border border-gray-200 rounded-xl p-6 text-center">
        <div class="text-3xl font-bold text-sky-600">GRS</div>
        <div class="text-sm text-gray-500 mt-1">certified chain-of-custody</div>
      </div>
      <div class="bg-white border border-gray-200 rounded-xl p-6 text-center">
        <div class="text-3xl font-bold text-sky-600">2027</div>
        <div class="text-sm text-gray-500 mt-1">EU PFAS ban ready</div>
      </div>
    </div>

    <div class="mt-16">
      <h2 class="text-2xl font-bold text-gray-900">Sustainable Fabric Options</h2>
      <div class="mt-6 space-y-6">
        <div class="bg-gradient-to-br from-teal-50 to-cyan-50 rounded-2xl border border-teal-200 p-6">
          <h3 class="text-lg font-semibold text-gray-900">Recycled Polyester (rPET)</h3>
          <p class="mt-2 text-sm text-gray-600">GRS-certified 100% post-consumer recycled polyester. Identical performance to virgin: same UPF 50+, waterproof, moisture wicking, and durability. Uses 50% less energy and 20% less water than virgin production. Available across woven and knit constructions.</p>
          <a href="/eco-friendly-fabric" class="mt-3 inline-flex text-sm font-medium text-sky-600 hover:underline">Browse rPET fabrics →</a>
        </div>
        <div class="bg-gradient-to-br from-green-50 to-emerald-50 rounded-2xl border border-green-200 p-6">
          <h3 class="text-lg font-semibold text-gray-900">Recycled Nylon</h3>
          <p class="mt-2 text-sm text-gray-600">Recycled nylon from pre-consumer waste and reclaimed fishing nets. High-tenacity options for durable outerwear shells. GRS-certified chain-of-custody. Suitable for waterproof laminate constructions with C0 DWR.</p>
          <a href="/eco-friendly-fabric" class="mt-3 inline-flex text-sm font-medium text-sky-600 hover:underline">Browse recycled nylon →</a>
        </div>
        <div class="bg-gradient-to-br from-blue-50 to-indigo-50 rounded-2xl border border-blue-200 p-6">
          <h3 class="text-lg font-semibold text-gray-900">PFC-Free DWR + Eco Laminates</h3>
          <p class="mt-2 text-sm text-gray-600">C0 fluorocarbon-free DWR finishes using dendrimer chemistry. Solvent-free PU coatings for waterproof breathable laminates. Full EU PFAS ban compliance documentation. Performance validated through third-party testing.</p>
          <a href="/solutions/fabrics-for-outdoor-jackets" class="mt-3 inline-flex text-sm font-medium text-sky-600 hover:underline">Learn about C0 DWR solutions →</a>
        </div>
      </div>
    </div>

    <div class="mt-16 bg-gray-50 rounded-2xl border border-gray-200 p-8">
      <h2 class="text-xl font-bold text-gray-900">Certifications</h2>
      <div class="mt-6 grid md:grid-cols-3 gap-4 text-sm text-gray-600">
        <div class="flex items-center gap-3 bg-white rounded-xl p-4 border border-gray-200">
          <span class="text-2xl">✓</span>
          <div><span class="font-semibold text-gray-900">GRS</span><p>Global Recycled Standard for recycled content verification and chain-of-custody</p></div>
        </div>
        <div class="flex items-center gap-3 bg-white rounded-xl p-4 border border-gray-200">
          <span class="text-2xl">✓</span>
          <div><span class="font-semibold text-gray-900">OEKO-TEX</span><p>Standard 100 certified — all products tested for harmful substances</p></div>
        </div>
        <div class="flex items-center gap-3 bg-white rounded-xl p-4 border border-gray-200">
          <span class="text-2xl">✓</span>
          <div><span class="font-semibold text-gray-900">REACH</span><p>EU chemical compliance for all fabrics and finishing treatments</p></div>
        </div>
      </div>
    </div>

    <div class="mt-12 flex flex-wrap gap-4">
      <a href="/contact" class="px-8 py-3 bg-gray-900 text-white rounded-full font-semibold hover:bg-gray-800 transition">Request Sustainable Fabric Samples</a>
      <a href="/evidence/case-studies/sustainable-jacket-fabric-development" class="px-8 py-3 border border-gray-200 text-gray-700 rounded-full font-semibold hover:border-gray-400 transition">View PFC-Free Case Study</a>
    </div>
  </section>

  <section class="sr-only" data-ai-block="definition" aria-hidden="true">
    <p>Sustainable outdoor textile solutions by Seekingtex. GRS-certified recycled polyester (rPET) from post-consumer bottles — 100% recycled content available, identical performance to virgin polyester, 50% less energy consumption. GRS-certified recycled nylon from pre-consumer waste and fishing nets. C0 PFC-free DWR using dendrimer chemistry — fluorocarbon-free, EU PFAS ban compliant. Solvent-free PU coatings for eco-friendly waterproof laminates. Certifications: GRS (Global Recycled Standard), OEKO-TEX Standard 100, REACH compliance. All sustainable fabrics available for custom OEM/ODM development. Serving outdoor apparel brands transitioning to eco-friendly materials.</p>
  </section>
</Layout>
