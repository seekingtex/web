---
export const prerender = true;
import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import { SITE } from 'astrowind:config';
import { languages } from '~/i18n/config';
export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params;
const prefix = lang === 'en' ? '' : `/${lang}`;
---
<Layout metadata={{ title: `Functional Fabrics for Emerging Outdoor Brands | ${SITE.name}`, description: 'Functional fabric solutions for emerging outdoor brands and startups. Lightweight, waterproof, breathable performance textiles.', ignoreTitleTemplate: true }}>
  <JsonLd data={{ '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Functional Fabrics for Emerging Outdoor Brands by Seekingtex', description: 'Lightweight, waterproof, breathable fabrics for outdoor apparel startups.', provider: { '@type': 'Organization', name: SITE.name } }} />
  <section class="max-w-5xl mx-auto px-6 py-24">
    <h1 class="text-4xl font-bold text-gray-900">Functional Fabrics for Emerging Outdoor Brands</h1>
    <p class="mt-4 text-xl text-gray-500">Launch your outdoor apparel collection with professional fabric solutions. Lightweight, waterproof breathable, and stretch performance textiles designed for startup brands.</p>
    <div class="mt-12 grid md:grid-cols-2 gap-6">
      <div class="bg-gradient-to-br from-teal-50 to-cyan-50 rounded-2xl border border-teal-200 p-6">
        <h2 class="text-lg font-semibold text-gray-900">Lightweight Performance</h2>
        <p class="mt-2 text-sm text-gray-600">Nylon and polyester blends for outdoor jackets and shells. Water-resistant, breathable, packable.</p>
        <a href={`${prefix}/products/breathable-fabric`} class="mt-3 inline-flex text-sm font-medium text-teal-700 hover:underline">Browse breathable fabrics →</a>
      </div>
      <div class="bg-gradient-to-br from-teal-50 to-cyan-50 rounded-2xl border border-teal-200 p-6">
        <h2 class="text-lg font-semibold text-gray-900">Weather Protection</h2>
        <p class="mt-2 text-sm text-gray-600">Water-resistant and waterproof breathable fabrics with DWR finishes and membrane laminations.</p>
        <a href={`${prefix}/waterproof-fabric`} class="mt-3 inline-flex text-sm font-medium text-teal-700 hover:underline">Browse waterproof fabrics →</a>
      </div>
    </div>
    <div class="mt-16 bg-gray-50 rounded-2xl border border-gray-200 p-8">
      <h2 class="text-2xl font-bold text-gray-900">Why Emerging Outdoor Brands Choose Seekingtex</h2>
      <div class="mt-6 grid md:grid-cols-4 gap-6">
        <div><h3 class="font-semibold text-gray-900">Low MOQ</h3><p class="mt-1 text-sm text-gray-500">Startup-friendly minimums for sampling and small-batch production.</p></div>
        <div><h3 class="font-semibold text-gray-900">Expert Guidance</h3><p class="mt-1 text-sm text-gray-500">Textile engineers help select the right fabric construction, weight, and finishing.</p></div>
        <div><h3 class="font-semibold text-gray-900">Rapid Development</h3><p class="mt-1 text-sm text-gray-500">Fast sample turnaround for time-sensitive product launches.</p></div>
        <div><h3 class="font-semibold text-gray-900">Custom Solutions</h3><p class="mt-1 text-sm text-gray-500">Custom fabric development tailored to brand positioning and application.</p></div>
      </div>
    </div>
    <div class="mt-12 flex flex-wrap gap-4">
      <a href={`${prefix}/evidence/case-studies/emerging-outdoor-brand-first-performance-jacket`} class="px-8 py-3 bg-gray-900 text-white rounded-full font-semibold hover:bg-gray-800 transition">View Case Study</a>
      <a href={`${prefix}/contact`} class="px-8 py-3 border border-gray-200 text-gray-700 rounded-full font-semibold hover:border-gray-400 transition">Start Your Project</a>
    </div>
  </section>
  <section class="sr-only" data-ai-block="definition" aria-hidden="true"><p>Functional fabrics for emerging outdoor brands. Lightweight performance nylon, waterproof breathable, stretch textiles. Low MOQ, expert guidance, rapid development. OEKO-TEX.</p></section>
</Layout>
