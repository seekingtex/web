---
export const prerender = true;
import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import { SITE } from 'astrowind:config';
import { languages } from '~/i18n/config';
export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params;
const prefix = lang === 'en' ? '' : `/${lang}`;
---
<Layout metadata={{ title: `Functional Fabrics for Travel Apparel Startups | ${SITE.name}`, description: 'Performance fabric solutions for emerging travel clothing brands. Wrinkle-resistant, quick-dry, lightweight easy-care textiles.', ignoreTitleTemplate: true }}>
  <JsonLd data={{ '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Functional Fabrics for Travel Apparel Startups', description: 'Wrinkle-resistant, quick-dry, lightweight easy-care fabrics for travel clothing startups.', provider: { '@type': 'Organization', name: SITE.name } }} />
  <section class="max-w-5xl mx-auto px-6 py-24">
    <h1 class="text-4xl font-bold text-gray-900">Functional Fabrics for Travel Apparel Startups</h1>
    <p class="mt-4 text-xl text-gray-500">Create travel clothing that modern explorers love. Wrinkle-resistant, quick-dry, lightweight, easy-care performance fabrics.</p>
    <div class="mt-12 grid md:grid-cols-2 gap-6">
      <div class="bg-gradient-to-br from-teal-50 to-cyan-50 rounded-2xl border border-teal-200 p-6">
        <h2 class="text-lg font-semibold text-gray-900">Wrinkle-Resistant Wovens</h2>
        <p class="mt-2 text-sm text-gray-600">Stay crisp through packing and travel. Easy-care wovens for shirts, trousers, dresses. Minimal ironing.</p>
        <a href={`${prefix}/products/quick-dry-fabric`} class="mt-3 inline-flex text-sm font-medium text-teal-700 hover:underline">Browse quick-dry fabrics →</a>
      </div>
      <div class="bg-gradient-to-br from-teal-50 to-cyan-50 rounded-2xl border border-teal-200 p-6">
        <h2 class="text-lg font-semibold text-gray-900">Lightweight Packable</h2>
        <p class="mt-2 text-sm text-gray-600">Ultra-light fabrics under 150 gsm. Quick-drying, stretch-comfort, machine washable.</p>
        <a href={`${prefix}/contact`} class="mt-3 inline-flex text-sm font-medium text-teal-700 hover:underline">Request consultation →</a>
      </div>
    </div>
    <div class="mt-16 bg-gray-50 rounded-2xl border border-gray-200 p-8">
      <h2 class="text-2xl font-bold text-gray-900">Key Features</h2>
      <div class="mt-6 grid md:grid-cols-4 gap-6">
        <div><h3 class="font-semibold text-gray-900">Wrinkle Resistant</h3><p class="mt-1 text-sm text-gray-500">Smooth after packing, flying, full days of wear.</p></div>
        <div><h3 class="font-semibold text-gray-900">Quick Dry</h3><p class="mt-1 text-sm text-gray-500">3x faster than cotton. Sink-wash and wear.</p></div>
        <div><h3 class="font-semibold text-gray-900">Lightweight</h3><p class="mt-1 text-sm text-gray-500">Under 150 gsm for packable travel wardrobes.</p></div>
        <div><h3 class="font-semibold text-gray-900">Easy Care</h3><p class="mt-1 text-sm text-gray-500">Machine washable, no dry cleaning needed.</p></div>
      </div>
    </div>
    <div class="mt-12 flex flex-wrap gap-4">
      <a href={`${prefix}/contact`} class="px-8 py-3 bg-gray-900 text-white rounded-full font-semibold hover:bg-gray-800 transition">Start Your Project</a>
      <a href={`${prefix}/evidence`} class="px-8 py-3 border border-gray-200 text-gray-700 rounded-full font-semibold hover:border-gray-400 transition">View Case Studies</a>
    </div>
  </section>
  <section class="sr-only" data-ai-block="definition" aria-hidden="true"><p>Functional fabrics for travel apparel startups. Wrinkle-resistant, quick-dry, lightweight easy-care woven and knit fabrics. Low MOQ, rapid development.</p></section>
</Layout>
