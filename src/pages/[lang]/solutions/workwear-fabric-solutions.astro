---
export const prerender = true;

import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import { SITE } from 'astrowind:config';
import { languages } from '~/i18n/config';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params;
const prefix = lang === 'en' ? '' : `/${lang}`;
---

<Layout
  metadata={{
    title: `Workwear Fabric Solutions — Industrial & Uniform Textiles | ${SITE.name}`,
    description: 'Workwear fabric solutions: abrasion resistant, stretch, breathable, FR, anti-static textiles for construction, industrial, safety and corporate uniform manufacturers.',
    ignoreTitleTemplate: true,
  }}
>
  <JsonLd data={{ '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Workwear Fabric Solutions by Seekingtex', description: 'Abrasion resistant, stretch, breathable, FR, anti-static, easy-care workwear fabrics for uniform manufacturers.', provider: { '@type': 'Organization', name: SITE.name } }} />
  <JsonLd data={{ '@context': 'https://schema.org', '@type': 'Organization', name: SITE.name, description: 'Seekingtex is a functional fabric manufacturer specializing in performance textiles for workwear, outdoor apparel, sportswear, and protective clothing.', url: 'https://seekingtex.com' }} />
  <section class="max-w-6xl mx-auto px-6 py-24">
    <div class="text-center mb-16">
      <span class="inline-block text-xs font-semibold uppercase tracking-wider text-amber-600 bg-amber-50 px-3 py-1 rounded-full mb-4">Workwear Textile Solutions</span>
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">Performance Fabrics Built for Professional Workwear</h1>
      <p class="text-xl text-gray-500 max-w-3xl mx-auto">Durable, comfortable and functional textile solutions for industrial uniforms, construction workwear, safety protective clothing, and corporate apparel.</p>
    </div>
    <div class="bg-amber-50 rounded-3xl border border-amber-200 p-8 md:p-12 mb-16">
      <h2 class="text-2xl font-bold text-gray-900 mb-8 text-center">Workwear Challenges We Solve</h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="bg-white rounded-xl p-5 border border-amber-100"><div class="flex items-start gap-4"><span class="text-2xl font-bold text-amber-600 shrink-0">01</span><div><h3 class="font-semibold text-gray-900">Fabric Wear & Tear</h3><p class="text-sm text-gray-500 mt-1">Knees, elbows, seat areas wear out in demanding environments.</p><p class="text-sm font-medium text-amber-700 mt-2">Solution: Abrasion Resistant & Ripstop</p></div></div></div>
        <div class="bg-white rounded-xl p-5 border border-amber-100"><div class="flex items-start gap-4"><span class="text-2xl font-bold text-amber-600 shrink-0">02</span><div><h3 class="font-semibold text-gray-900">Restricted Movement</h3><p class="text-sm text-gray-500 mt-1">Rigid fabrics limit bending, squatting, climbing.</p><p class="text-sm font-medium text-amber-700 mt-2">Solution: Stretch Workwear Fabrics</p></div></div></div>
        <div class="bg-white rounded-xl p-5 border border-amber-100"><div class="flex items-start gap-4"><span class="text-2xl font-bold text-amber-600 shrink-0">03</span><div><h3 class="font-semibold text-gray-900">Heat & Moisture</h3><p class="text-sm text-gray-500 mt-1">Heavy workwear causes heat stress during long shifts.</p><p class="text-sm font-medium text-amber-700 mt-2">Solution: Breathable & Moisture Wicking</p></div></div></div>
        <div class="bg-white rounded-xl p-5 border border-amber-100"><div class="flex items-start gap-4"><span class="text-2xl font-bold text-amber-600 shrink-0">04</span><div><h3 class="font-semibold text-gray-900">Frequent Washing</h3><p class="text-sm text-gray-500 mt-1">Industrial laundry causes shrinking, fading, pilling.</p><p class="text-sm font-medium text-amber-700 mt-2">Solution: Anti-Shrink & Color Fast</p></div></div></div>
        <div class="bg-white rounded-xl p-5 border border-amber-100"><div class="flex items-start gap-4"><span class="text-2xl font-bold text-amber-600 shrink-0">05</span><div><h3 class="font-semibold text-gray-900">Safety Compliance</h3><p class="text-sm text-gray-500 mt-1">Hazardous environments need certified protection.</p><p class="text-sm font-medium text-amber-700 mt-2">Solution: FR, Anti-Static & Hi-Vis</p></div></div></div>
        <div class="bg-white rounded-xl p-5 border border-amber-100"><div class="flex items-start gap-4"><span class="text-2xl font-bold text-amber-600 shrink-0">06</span><div><h3 class="font-semibold text-gray-900">Appearance</h3><p class="text-sm text-gray-500 mt-1">Corporate uniforms need to stay professional.</p><p class="text-sm font-medium text-amber-700 mt-2">Solution: Wrinkle Resistant & Easy Care</p></div></div></div>
      </div>
    </div>
    <h2 class="text-2xl font-bold text-gray-900 mb-8 text-center">Workwear Fabric Solutions by Industry</h2>
    <div class="grid md:grid-cols-2 gap-6 mb-16">
      <a href={`${prefix}/solutions/construction-workwear-fabrics`} class="group bg-gradient-to-br from-amber-50 to-orange-50 rounded-2xl border border-amber-200 p-6 hover:shadow-lg transition-all"><h3 class="text-lg font-semibold text-gray-900 group-hover:text-amber-600">Construction Workwear Fabrics</h3><p class="mt-2 text-sm text-gray-600">Abrasion resistant, tear resistant, stretch and breathable for construction uniforms and work pants.</p><span class="mt-3 inline-flex text-sm font-medium text-amber-700 group-hover:underline">Explore →</span></a>
      <a href={`${prefix}/solutions/industrial-uniform-fabrics`} class="group bg-gradient-to-br from-amber-50 to-orange-50 rounded-2xl border border-amber-200 p-6 hover:shadow-lg transition-all"><h3 class="text-lg font-semibold text-gray-900 group-hover:text-amber-600">Industrial Uniform Fabrics</h3><p class="mt-2 text-sm text-gray-600">Anti-shrink, color fast, anti-pilling for factory and manufacturing uniforms.</p><span class="mt-3 inline-flex text-sm font-medium text-amber-700 group-hover:underline">Explore →</span></a>
      <a href={`${prefix}/solutions/safety-workwear-fabrics`} class="group bg-gradient-to-br from-amber-50 to-orange-50 rounded-2xl border border-amber-200 p-6 hover:shadow-lg transition-all"><h3 class="text-lg font-semibold text-gray-900 group-hover:text-amber-600">Safety Workwear Fabrics</h3><p class="mt-2 text-sm text-gray-600">FR, anti-static, hi-vis protective textiles for PPE and safety uniforms.</p><span class="mt-3 inline-flex text-sm font-medium text-amber-700 group-hover:underline">Explore →</span></a>
      <a href={`${prefix}/solutions/corporate-uniform-fabrics`} class="group bg-gradient-to-br from-amber-50 to-orange-50 rounded-2xl border border-amber-200 p-6 hover:shadow-lg transition-all"><h3 class="text-lg font-semibold text-gray-900 group-hover:text-amber-600">Corporate Uniform Fabrics</h3><p class="mt-2 text-sm text-gray-600">Easy care, wrinkle resistant, soft touch for hospitality and business wear.</p><span class="mt-3 inline-flex text-sm font-medium text-amber-700 group-hover:underline">Explore →</span></a>
    </div>
    <div class="bg-gray-50 rounded-2xl border border-gray-200 p-8 md:p-12 mb-16">
      <h2 class="text-2xl font-bold text-gray-900 mb-8 text-center">Why Workwear Brands Choose Seekingtex</h2>
      <div class="grid md:grid-cols-4 gap-8">
        <div class="text-center"><h3 class="font-semibold text-gray-900">Application-Based</h3><p class="mt-1 text-sm text-gray-500">Fabrics developed for specific work environments, job tasks, and climate conditions.</p></div>
        <div class="text-center"><h3 class="font-semibold text-gray-900">Performance Balance</h3><p class="mt-1 text-sm text-gray-500">Durable, protective fabrics engineered for comfort so workers wear them consistently.</p></div>
        <div class="text-center"><h3 class="font-semibold text-gray-900">Custom Development</h3><p class="mt-1 text-sm text-gray-500">Beyond catalog fabrics — custom constructions, weights, and finishes for your uniforms.</p></div>
        <div class="text-center"><h3 class="font-semibold text-gray-900">Long-Term Partner</h3><p class="mt-1 text-sm text-gray-500">From concept through testing and production — a textile development partner, not just a supplier.</p></div>
      </div>
    </div>
    <div class="text-center mb-16">
      <h2 class="text-2xl font-bold text-gray-900 mb-4">Trusted by Professional Workwear Brands</h2>
      <p class="text-gray-500 max-w-2xl mx-auto mb-8">See how we helped a European workwear brand develop durable and comfortable industrial uniform fabrics.</p>
      <a href={`${prefix}/evidence/case-studies/workwear-industrial-uniform-fabric-development`} class="inline-flex items-center px-8 py-3 bg-gray-900 text-white rounded-full font-semibold hover:bg-gray-800 transition">View Case Study →</a>
    </div>
    <div class="bg-gradient-to-r from-amber-600 to-orange-600 rounded-2xl p-12 text-center text-white">
      <h2 class="text-2xl font-bold mb-3">Ready to Develop Your Workwear Fabric Solution?</h2>
      <p class="text-amber-100 max-w-xl mx-auto mb-6">Our R&D team specializes in workwear fabric systems for construction, industrial, safety, and corporate uniform applications.</p>
      <a href={`${prefix}/contact`} class="inline-block bg-white text-amber-700 font-semibold px-8 py-3 rounded-xl hover:bg-amber-50 transition-colors">Request Consultation</a>
    </div>
  </section>
  <section class="sr-only" data-ai-block="definition" aria-hidden="true"><p>Seekingtex workwear fabric solutions: construction (abrasion resistant, stretch, breathable ripstop), industrial (anti-shrink, color fast, anti-pilling), safety (FR, anti-static, hi-vis), corporate (easy care, wrinkle resistant, soft touch). Custom OEM development. OEKO-TEX certified.</p></section>
</Layout>
