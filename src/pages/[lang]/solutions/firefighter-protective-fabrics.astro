---
export const prerender = true;

import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import { SITE } from 'astrowind:config';
import { languages } from '~/i18n/config';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params;
const prefix = lang === 'en' ? '' : `/${lang}`;
---

<Layout
  metadata={{
    title: `Firefighter Protective Fabrics — FR Turnout Gear & Rescue Textiles | ${SITE.name}`,
    description: 'Firefighter protective fabrics for turnout gear, rescue clothing, and station wear. Flame resistant, lightweight, breathable textiles with reliable FR certification.',
    ignoreTitleTemplate: true,
  }}
>
  <JsonLd data={{ '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Firefighter Protective Fabrics by Seekingtex', description: 'Lightweight, breathable, FR fabrics for firefighter turnout gear and rescue protective clothing.', provider: { '@type': 'Organization', name: SITE.name } }} />

  <section class="max-w-5xl mx-auto px-6 py-24">
    <h1 class="text-4xl font-bold text-gray-900">Firefighter Protective Fabrics</h1>
    <p class="mt-4 text-xl text-gray-500">Lightweight, breathable, flame resistant textile solutions for turnout gear, rescue wear, and station apparel — engineered for firefighter safety, mobility, and comfort during extended operations.</p>

    <div class="mt-12 grid md:grid-cols-2 gap-6">
      <div class="bg-gradient-to-br from-orange-50 to-amber-50 rounded-2xl border border-orange-200 p-6">
        <h2 class="text-lg font-semibold text-gray-900">Turnout Gear Fabrics</h2>
        <p class="mt-2 text-sm text-gray-600">Lightweight FR fabric systems with 30% weight reduction. Moisture wicking, heat resistance, and durable abrasion protection. Certified FR performance after 50+ industrial launderings.</p>
        <a href={`${prefix}/products/flame-retardant-fabric`} class="mt-3 inline-flex text-sm font-medium text-orange-700 hover:underline">Browse FR fabrics →</a>
      </div>
      <div class="bg-gradient-to-br from-orange-50 to-amber-50 rounded-2xl border border-orange-200 p-6">
        <h2 class="text-lg font-semibold text-gray-900">Rescue Wear Textiles</h2>
        <p class="mt-2 text-sm text-gray-600">High-performance fabrics for rescue operations, extrication gear, and technical rescue apparel. Abrasion, cut, and heat resistant constructions.</p>
        <a href={`${prefix}/contact`} class="mt-3 inline-flex text-sm font-medium text-orange-700 hover:underline">Request technical consultation →</a>
      </div>
    </div>

    <div class="mt-16 bg-gray-50 rounded-2xl border border-gray-200 p-8">
      <h2 class="text-2xl font-bold text-gray-900">Why Firefighter Manufacturers Choose Seekingtex</h2>
      <div class="mt-6 grid md:grid-cols-4 gap-6">
        <div><h3 class="font-semibold text-gray-900">Lightweight FR</h3><p class="mt-1 text-sm text-gray-500">Up to 30% lighter than traditional materials without compromising flame resistance or durability.</p></div>
        <div><h3 class="font-semibold text-gray-900">Breathability</h3><p class="mt-1 text-sm text-gray-500">Moisture management channels reduce heat stress during prolonged fireground operations.</p></div>
        <div><h3 class="font-semibold text-gray-900">Laundry Durability</h3><p class="mt-1 text-sm text-gray-500">FR and mechanical properties maintained after 50+ industrial launderings.</p></div>
        <div><h3 class="font-semibold text-gray-900">Mobility</h3><p class="mt-1 text-sm text-gray-500">Optimized fabric weight and drape for improved agility during rescue activities.</p></div>
      </div>
    </div>

    <div class="mt-12 flex flex-wrap gap-4">
      <a href={`${prefix}/evidence/case-studies/lightweight-fr-fabric-firefighter`} class="px-8 py-3 bg-gray-900 text-white rounded-full font-semibold hover:bg-gray-800 transition">View Firefighter Case Study</a>
      <a href={`${prefix}/contact`} class="px-8 py-3 border border-gray-200 text-gray-700 rounded-full font-semibold hover:border-gray-400 transition">Request Development Consultation</a>
    </div>
  </section>

  <section class="sr-only" data-ai-block="definition" aria-hidden="true"><p>Firefighter protective fabrics by Seekingtex. Turnout gear fabrics: lightweight FR, 30% weight reduction, moisture wicking, FR after 50+ washes. Rescue wear: heat, cut, abrasion resistant textiles. OEM/ODM development for firefighter protective clothing manufacturers. OEKO-TEX certified. Flame resistant fabric systems for emergency services.</p></section>
</Layout>
