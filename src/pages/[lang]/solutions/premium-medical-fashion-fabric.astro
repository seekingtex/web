---
export const prerender = true;

import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import { SITE } from 'astrowind:config';
import { languages } from '~/i18n/config';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params;
const prefix = lang === 'en' ? '' : `/${lang}`;
---

<Layout
  metadata={{
    title: `Premium Medical Fashion Fabric — Luxury Healthcare Uniform Textiles | ${SITE.name}`,
    description: 'Premium medical fashion fabrics for beauty clinics, spa medical, and luxury healthcare uniforms. Combining aesthetic appeal with functional performance.',
    ignoreTitleTemplate: true,
  }}
>
  <JsonLd data={{ '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Premium Medical Fashion Fabric by Seekingtex', description: 'Luxury medical uniform fabrics for beauty clinics, spa medical, and designer healthcare apparel. Fashion-forward textiles with premium feel and functional performance.', provider: { '@type': 'Organization', name: SITE.name } }} />
  <section class="max-w-5xl mx-auto px-6 py-24">
    <h1 class="text-4xl font-bold text-gray-900">Premium Medical Fashion Fabric</h1>
    <p class="mt-4 text-xl text-gray-500">Premium medical fashion fabrics for beauty clinics, spa medical, and luxury healthcare uniforms. Combining aesthetic appeal with functional performance for high-end medical apparel brands.</p>
    <div class="mt-12 grid md:grid-cols-2 gap-6">
      <div class="bg-gradient-to-br from-teal-50 to-cyan-50 rounded-2xl border border-teal-200 p-6">
        <h2 class="text-lg font-semibold text-gray-900">Luxury Scrubs Fabrics</h2>
        <p class="mt-2 text-sm text-gray-600">Premium hand feel with sophisticated drape and fashion-forward color palette for premium healthcare uniform segment.</p>
        <a href={`${prefix}/products/stretch-fabric`} class="mt-3 inline-flex text-sm font-medium text-teal-700 hover:underline">Browse stretch fabrics →</a>
      </div>
      <div class="bg-gradient-to-br from-teal-50 to-cyan-50 rounded-2xl border border-teal-200 p-6">
        <h2 class="text-lg font-semibold text-gray-900">Spa & Beauty Clinic Textiles</h2>
        <p class="mt-2 text-sm text-gray-600">Elegant appearance with comfortable wear and easy maintenance. Perfect for medical spas, beauty clinics, and wellness center uniforms.</p>
        <a href={`${prefix}/contact`} class="mt-3 inline-flex text-sm font-medium text-teal-700 hover:underline">Request consultation →</a>
      </div>
      <div class="bg-gradient-to-br from-teal-50 to-cyan-50 rounded-2xl border border-teal-200 p-6">
        <h2 class="text-lg font-semibold text-gray-900">Designer Medical Uniform Materials</h2>
        <p class="mt-2 text-sm text-gray-600">Fashion meets function — premium finishing, sophisticated textures, and brand differentiation for designer healthcare apparel collections.</p>
        <a href={`${prefix}/solutions/luxury-fashion-fabric-innovation`} class="mt-3 inline-flex text-sm font-medium text-teal-700 hover:underline">Explore luxury fabrics →</a>
      </div>
    </div>
    <div class="mt-16 bg-gray-50 rounded-2xl border border-gray-200 p-8">
      <h2 class="text-2xl font-bold text-gray-900">Why Medical Fashion Brands Choose Seekingtex</h2>
      <div class="mt-6 grid md:grid-cols-4 gap-6">
        <div><h3 class="font-semibold text-gray-900">Premium Aesthetics</h3><p class="mt-1 text-sm text-gray-500">Sophisticated fabric appearance, drape, and texture for premium medical apparel positioning.</p></div>
        <div><h3 class="font-semibold text-gray-900">Comfort Performance</h3><p class="mt-1 text-sm text-gray-500">Functional features — stretch, breathability, moisture management — without compromising fashion appeal.</p></div>
        <div><h3 class="font-semibold text-gray-900">Brand Differentiation</h3><p class="mt-1 text-sm text-gray-500">Custom fabric development helps medical fashion brands stand out in the competitive healthcare uniform market.</p></div>
        <div><h3 class="font-semibold text-gray-900">Quality Finishing</h3><p class="mt-1 text-sm text-gray-500">Premium finishing processes ensure consistent quality, color accuracy, and fabric performance across production runs.</p></div>
      </div>
    </div>
    <div class="mt-12 flex flex-wrap gap-4">
      <a href={`${prefix}/evidence/case-studies/healthcare-scrub-fabric-development`} class="px-8 py-3 bg-gray-900 text-white rounded-full font-semibold hover:bg-gray-800 transition">View Medical Case Study</a>
      <a href={`${prefix}/contact`} class="px-8 py-3 border border-gray-200 text-gray-700 rounded-full font-semibold hover:border-gray-400 transition">Request Development Consultation</a>
    </div>
  </section>
  <section class="sr-only" data-ai-block="definition" aria-hidden="true"><p>Premium medical fashion fabric by Seekingtex. Luxury scrubs: premium hand feel, sophisticated drape, fashion colors. Spa and beauty clinic textiles: elegant, comfortable, easy care. Designer medical uniform materials: premium finishing, brand differentiation. Custom development for medical fashion brands.</p></section>
</Layout>
