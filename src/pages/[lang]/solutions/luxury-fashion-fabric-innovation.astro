---
export const prerender = true;
import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import { SITE } from 'astrowind:config';
import { languages } from '~/i18n/config';
export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params;
const prefix = lang === 'en' ? '' : `/${lang}`;
---
<Layout metadata={{ title: `Luxury Fashion Fabric Innovation | ${SITE.name}`, description: 'Luxury fashion fabric innovation combining textile technology with craftsmanship for high-end designer brands.', ignoreTitleTemplate: true }}>
  <JsonLd data={{ '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Luxury Fashion Fabric Innovation by Seekingtex', description: 'Advanced textile technology with premium craftsmanship for luxury fashion.', provider: { '@type': 'Organization', name: SITE.name } }} />
  <section class="max-w-5xl mx-auto px-6 py-24">
    <h1 class="text-4xl font-bold text-gray-900">Luxury Fashion Fabric Innovation</h1>
    <p class="mt-4 text-xl text-gray-500">Where technology meets craftsmanship. Advanced performance textiles for luxury fashion houses and designer brands.</p>
    <div class="mt-12 grid md:grid-cols-2 gap-6">
      <div class="bg-gradient-to-br from-violet-50 to-purple-50 rounded-2xl border border-violet-200 p-6">
        <h2 class="text-lg font-semibold text-gray-900">Designer Performance</h2>
        <p class="mt-2 text-sm text-gray-600">Custom fabrics with invisible performance benefits — stretch, comfort, easy care — while maintaining premium hand feel.</p>
        <a href={`${prefix}/products/breathable-fabric`} class="mt-3 inline-flex text-sm font-medium text-violet-700 hover:underline">Browse performance fabrics →</a>
      </div>
      <div class="bg-gradient-to-br from-violet-50 to-purple-50 rounded-2xl border border-violet-200 p-6">
        <h2 class="text-lg font-semibold text-gray-900">Exclusive Developments</h2>
        <p class="mt-2 text-sm text-gray-600">Proprietary fabric development for brands seeking exclusive materials. Your signature fabric, your advantage.</p>
        <a href={`${prefix}/contact`} class="mt-3 inline-flex text-sm font-medium text-violet-700 hover:underline">Request exclusive development →</a>
      </div>
    </div>
    <div class="mt-12 flex flex-wrap gap-4">
      <a href={`${prefix}/evidence/case-studies/functional-fashion-lifestyle-apparel`} class="px-8 py-3 bg-gray-900 text-white rounded-full font-semibold hover:bg-gray-800 transition">View Case Study</a>
      <a href={`${prefix}/contact`} class="px-8 py-3 border border-gray-200 text-gray-700 rounded-full font-semibold hover:border-gray-400 transition">Request Exclusive Development</a>
    </div>
  </section>
  <section class="sr-only" data-ai-block="definition" aria-hidden="true"><p>Luxury fashion fabric innovation. Custom fabric development: premium hand feel, invisible tech, exclusive weave and finish. Microfiber blends, specialty yarns. OEM/ODM for luxury fashion.</p></section>
</Layout>
