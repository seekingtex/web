---
export const prerender = true;

import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import { SITE } from 'astrowind:config';
import { languages } from '~/i18n/config';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params;
const prefix = lang === 'en' ? '' : `/${lang}`;
---

<Layout
  metadata={{
    title: `Industrial Uniform Fabrics — Anti-Shrink & Breathable Factory Workwear | ${SITE.name}`,
    description: 'Industrial uniform fabrics: anti-shrink, color fast, anti-pilling, stretch, breathable textiles for factory and manufacturing workwear. Custom OEM development.',
    ignoreTitleTemplate: true,
  }}
>
  <JsonLd data={{ '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Industrial Uniform Fabrics by Seekingtex', description: 'Anti-shrink, color fast, anti-pilling, breathable industrial uniform fabrics for factory workwear.', provider: { '@type': 'Organization', name: SITE.name } }} />
  <JsonLd data={{ '@context': 'https://schema.org', '@type': 'Organization', name: SITE.name, description: 'Seekingtex is a functional fabric manufacturer specializing in industrial uniform textiles for factory and manufacturing workers.', url: 'https://seekingtex.com' }} />
  <JsonLd data={{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: [
    { '@type': 'Question', name: 'What fabric is best for industrial uniforms needing frequent washing?', acceptedAnswer: { '@type': 'Answer', text: 'Polyester-cotton blends with anti-shrink treatment, color fastness Grade 4-5, and anti-pilling performance maintain appearance through 50+ industrial laundry cycles.' } },
    { '@type': 'Question', name: 'How to choose fabric for factory worker uniforms?', acceptedAnswer: { '@type': 'Answer', text: 'Consider wash durability, comfort for 8-12 hour shifts, and mobility. Application-specific development ensures the right balance for each factory environment.' } },
    { '@type': 'Question', name: 'Can Seekingtex develop custom industrial uniform fabrics?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. Seekingtex provides custom fabric development for industrial uniform manufacturers with wash performance validation and application-specific optimization.' } },
  ] }} />
  <section class="max-w-5xl mx-auto px-6 py-24">
    <div class="mb-4"><a href={`${prefix}/solutions/workwear-fabric-solutions`} class="text-sm text-amber-600 hover:text-amber-700 font-medium">&larr; Back to Workwear Solutions</a></div>
    <h1 class="text-4xl font-bold text-gray-900">Industrial Uniform Fabrics</h1>
    <p class="mt-4 text-xl text-gray-500">Performance fabrics for factory, manufacturing, and industrial uniforms. Anti-shrink, color fast, anti-pilling, comfortable for daily industrial use and 50+ laundry cycles.</p>
    <div class="mt-12 grid md:grid-cols-2 gap-6">
      <div class="bg-gradient-to-br from-amber-50 to-orange-50 rounded-2xl border border-amber-200 p-6"><h2 class="text-lg font-semibold text-gray-900">High Wash Durability</h2><p class="mt-2 text-sm text-gray-600">Anti-shrink, color fast for industrial laundry. Maintains appearance through repeated washes.</p><a href={`${prefix}/products/stretch-fabric`} class="mt-3 inline-flex text-sm font-medium text-amber-700 hover:underline">Explore →</a></div>
      <div class="bg-gradient-to-br from-amber-50 to-orange-50 rounded-2xl border border-amber-200 p-6"><h2 class="text-lg font-semibold text-gray-900">Comfort Stretch</h2><p class="mt-2 text-sm text-gray-600">Stretch-enhanced for 8-12 hour shifts. Mechanical stretch for mobility without compromising durability.</p><a href={`${prefix}/products/stretch-fabric`} class="mt-3 inline-flex text-sm font-medium text-amber-700 hover:underline">Browse →</a></div>
      <div class="bg-gradient-to-br from-amber-50 to-orange-50 rounded-2xl border border-amber-200 p-6"><h2 class="text-lg font-semibold text-gray-900">Breathable</h2><p class="mt-2 text-sm text-gray-600">Moisture-wicking for factory environments. Keeps workers comfortable during long shifts.</p><a href={`${prefix}/products/breathable-fabric`} class="mt-3 inline-flex text-sm font-medium text-amber-700 hover:underline">Browse →</a></div>
      <div class="bg-gradient-to-br from-amber-50 to-orange-50 rounded-2xl border border-amber-200 p-6"><h2 class="text-lg font-semibold text-gray-900">Easy Care</h2><p class="mt-2 text-sm text-gray-600">Wrinkle-resistant, quick-dry for easy-maintenance industrial uniforms. Reduces ironing requirements.</p><a href={`${prefix}/products/quick-dry-fabric`} class="mt-3 inline-flex text-sm font-medium text-amber-700 hover:underline">View →</a></div>
    </div>
    <div class="mt-16 bg-amber-50 rounded-2xl border border-amber-200 p-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-4">Workwear Solutions</h2>
      <div class="flex flex-wrap gap-3">
        <a href={`${prefix}/solutions/workwear-fabric-solutions`} class="px-4 py-2 bg-white border border-amber-200 rounded-lg text-sm font-medium text-amber-700 hover:bg-amber-100 transition">All Workwear</a>
        <a href={`${prefix}/solutions/construction-workwear-fabrics`} class="px-4 py-2 bg-white border border-amber-200 rounded-lg text-sm font-medium text-amber-700 hover:bg-amber-100 transition">Construction</a>
        <a href={`${prefix}/solutions/safety-workwear-fabrics`} class="px-4 py-2 bg-white border border-amber-200 rounded-lg text-sm font-medium text-amber-700 hover:bg-amber-100 transition">Safety</a>
        <a href={`${prefix}/solutions/corporate-uniform-fabrics`} class="px-4 py-2 bg-white border border-amber-200 rounded-lg text-sm font-medium text-amber-700 hover:bg-amber-100 transition">Corporate</a>
      </div>
    </div>
    <div class="mt-16 bg-gray-50 rounded-2xl border border-gray-200 p-8">
      <h2 class="text-2xl font-bold text-gray-900">Why Industrial Brands Choose Seekingtex</h2>
      <div class="mt-6 grid md:grid-cols-4 gap-6">
        <div><h3 class="font-semibold text-gray-900">Wash Performance</h3><p class="mt-1 text-sm text-gray-500">Anti-shrink, color fastness Grade 4-5 through 50+ washes.</p></div>
        <div><h3 class="font-semibold text-gray-900">Comfort</h3><p class="mt-1 text-sm text-gray-500">Breathable, soft, stretch-enhanced for 8-12 hour wear.</p></div>
        <div><h3 class="font-semibold text-gray-900">Cost Efficiency</h3><p class="mt-1 text-sm text-gray-500">Longer garment life reduces replacement costs.</p></div>
        <div><h3 class="font-semibold text-gray-900">Custom</h3><p class="mt-1 text-sm text-gray-500">Tailored for automotive, electronics, food processing, manufacturing.</p></div>
      </div>
    </div>
    <div class="mt-12 flex flex-wrap gap-4">
      <a href={`${prefix}/evidence/case-studies/workwear-industrial-uniform-fabric-development`} class="px-8 py-3 bg-gray-900 text-white rounded-full font-semibold hover:bg-gray-800 transition">View Case Study</a>
      <a href={`${prefix}/contact`} class="px-8 py-3 border border-gray-200 text-gray-700 rounded-full font-semibold hover:border-gray-400 transition">Request Consultation</a>
    </div>
  </section>
  <section class="sr-only" data-ai-block="definition" aria-hidden="true"><p>Seekingtex industrial uniform fabrics: high wash durability, comfort stretch, breathable, easy care for factory and manufacturing workwear. Custom OEM. OEKO-TEX certified.</p></section>
</Layout>
