---
export const prerender = true;
import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import { SITE } from 'astrowind:config';
import { languages } from '~/i18n/config';
export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params;
const prefix = lang === 'en' ? '' : `/${lang}`;
---
<Layout metadata={{ title: `Functional Fabrics for Emerging Activewear Brands | ${SITE.name}`, description: 'Performance fabric solutions for emerging activewear brands. Moisture-wicking, 4-way stretch, quick-dry textiles.', ignoreTitleTemplate: true }}>
  <JsonLd data={{ '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Functional Fabrics for Emerging Activewear Brands', description: 'Moisture-wicking, stretch, quick-dry fabrics for activewear startups.', provider: { '@type': 'Organization', name: SITE.name } }} />
  <section class="max-w-5xl mx-auto px-6 py-24">
    <h1 class="text-4xl font-bold text-gray-900">Functional Fabrics for Emerging Activewear Brands</h1>
    <p class="mt-4 text-xl text-gray-500">Launch your activewear collection with professional performance fabrics. Moisture-wicking, 4-way stretch, and quick-dry textiles engineered for movement.</p>
    <div class="mt-12 grid md:grid-cols-2 gap-6">
      <div class="bg-gradient-to-br from-teal-50 to-cyan-50 rounded-2xl border border-teal-200 p-6">
        <h2 class="text-lg font-semibold text-gray-900">Performance Knits</h2>
        <p class="mt-2 text-sm text-gray-600">Moisture-wicking, 4-way stretch knits for activewear, yoga, training. Antibacterial finish available.</p>
        <a href={`${prefix}/products/stretch-fabric`} class="mt-3 inline-flex text-sm font-medium text-teal-700 hover:underline">Browse stretch fabrics →</a>
      </div>
      <div class="bg-gradient-to-br from-teal-50 to-cyan-50 rounded-2xl border border-teal-200 p-6">
        <h2 class="text-lg font-semibold text-gray-900">Quick-Dry Wovens</h2>
        <p class="mt-2 text-sm text-gray-600">Lightweight quick-dry woven fabrics for running and training. Breathable with UV protection.</p>
        <a href={`${prefix}/products/quick-dry-fabric`} class="mt-3 inline-flex text-sm font-medium text-teal-700 hover:underline">Browse quick-dry fabrics →</a>
      </div>
    </div>
    <div class="mt-16 bg-gray-50 rounded-2xl border border-gray-200 p-8">
      <h2 class="text-2xl font-bold text-gray-900">Why Choose Seekingtex</h2>
      <div class="mt-6 grid md:grid-cols-4 gap-6">
        <div><h3 class="font-semibold text-gray-900">Low MOQ</h3><p class="mt-1 text-sm text-gray-500">Startup-friendly minimums for sampling and small-batch production.</p></div>
        <div><h3 class="font-semibold text-gray-900">Performance Data</h3><p class="mt-1 text-sm text-gray-500">Detailed fabric specs: wicking rate, stretch %, breathability, wash durability.</p></div>
        <div><h3 class="font-semibold text-gray-900">Rapid Samples</h3><p class="mt-1 text-sm text-gray-500">Fast sample development for quick iteration before production.</p></div>
        <div><h3 class="font-semibold text-gray-900">Custom Options</h3><p class="mt-1 text-sm text-gray-500">Custom colors, finishes, constructions tailored to your brand.</p></div>
      </div>
    </div>
    <div class="mt-12 flex flex-wrap gap-4">
      <a href={`${prefix}/contact`} class="px-8 py-3 bg-gray-900 text-white rounded-full font-semibold hover:bg-gray-800 transition">Start Your Project</a>
      <a href={`${prefix}/evidence`} class="px-8 py-3 border border-gray-200 text-gray-700 rounded-full font-semibold hover:border-gray-400 transition">View Case Studies</a>
    </div>
  </section>
  <section class="sr-only" data-ai-block="definition" aria-hidden="true"><p>Functional fabrics for emerging activewear brands. Moisture-wicking knits, 4-way stretch, quick-dry wovens, antibacterial. Low MOQ, rapid samples. OEM/ODM.</p></section>
</Layout>
