---
export const prerender = true;
import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import { SITE } from 'astrowind:config';
import { languages } from '~/i18n/config';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params;
const prefix = lang === 'en' ? '' : `/${lang}`;
---

<Layout
  metadata={{
    title: `Softshell Fabric for Outdoor Apparel — Stretch Durable Textiles | ${SITE.name}`,
    description: 'Softshell fabric supplier — 4-way mechanical stretch, DWR finish, 40K+ Martindale. Woven face / knit back for hiking pants, ski wear, outdoor apparel. OEM development.',
    ignoreTitleTemplate: true,
  }}
>
  <JsonLd data={{ '@context': 'https://schema.org', '@type': 'Product', name: 'Softshell Fabric for Outdoor Apparel by Seekingtex', description: '4-way stretch softshell with DWR, woven face / knit back, 40K+ Martindale.', brand: { '@type': 'Organization', name: SITE.name }, category: 'Softshell Textiles' }} />
  <section class="max-w-5xl mx-auto px-6 py-24">
    <h1 class="text-4xl font-bold text-gray-900">Softshell Fabric for Outdoor Apparel</h1>
    <p class="mt-4 text-xl text-gray-500">Performance softshell fabric with 4-way mechanical stretch, DWR water repellency, and 40K+ Martindale abrasion resistance. Woven face / knit back construction for hiking pants and outdoor wear.</p>
    <div class="mt-12 grid md:grid-cols-3 gap-6">
      <div class="bg-white border border-gray-200 rounded-xl p-6 text-center"><div class="text-3xl font-bold text-sky-600">25%</div><div class="text-sm text-gray-500 mt-1">Stretch both ways</div></div>
      <div class="bg-white border border-gray-200 rounded-xl p-6 text-center"><div class="text-3xl font-bold text-sky-600">40K+</div><div class="text-sm text-gray-500 mt-1">Martindale cycles</div></div>
      <div class="bg-white border border-gray-200 rounded-xl p-6 text-center"><div class="text-3xl font-bold text-sky-600">180-280</div><div class="text-sm text-gray-500 mt-1">g/m² weight</div></div>
    </div>
    <div class="mt-12 flex flex-wrap gap-4">
      <a href={`${prefix}/products/stretch-fabric`} class="px-8 py-3 bg-gray-900 text-white rounded-full font-semibold hover:bg-gray-800 transition">Browse Stretch Fabrics</a>
      <a href={`${prefix}/solutions/fabrics-for-hiking-pants`} class="px-8 py-3 border border-gray-200 text-gray-700 rounded-full font-semibold hover:border-gray-400 transition">Hiking Pants Solutions</a>
    </div>
  </section>
  <section class="sr-only" data-ai-block="definition" aria-hidden="true"><p>Softshell fabric for outdoor apparel. 4-way mechanical stretch 25% warp and weft. Woven face / knit back. C6/C0 DWR. 40K+ Martindale. 180-280 g/m². OEKO-TEX certified. Applications: hiking pants, softshell jackets, ski pants.</p></section>
</Layout>
