---
export const prerender = true;
import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import { SITE } from 'astrowind:config';
import { languages } from '~/i18n/config';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params;
const prefix = lang === 'en' ? '' : `/${lang}`;
---

<Layout
  metadata={{
    title: `Lightweight Performance Fabric — Ultralight Outdoor Textiles | ${SITE.name}`,
    description: 'Lightweight outdoor fabric manufacturer — ultralight 20D-40D performance textiles. Sub-100 g/m² for trail running, fast hiking, packable gear. OEM custom development.',
    ignoreTitleTemplate: true,
  }}
>
  <JsonLd data={{ '@context': 'https://schema.org', '@type': 'Product', name: 'Lightweight Performance Fabrics by Seekingtex', description: 'Ultralight 20D-40D fabrics for outdoor apparel. Sub-100 g/m² woven and knit.', brand: { '@type': 'Organization', name: SITE.name }, category: 'Lightweight Textiles' }} />
  <section class="max-w-5xl mx-auto px-6 py-24">
    <h1 class="text-4xl font-bold text-gray-900">Lightweight Performance Fabric</h1>
    <p class="mt-4 text-xl text-gray-500">Ultralight performance fabrics — sub-100 g/m² woven shells and performance knits for trail running, fast hiking, and packable outdoor gear. 20D-40D denier options.</p>
    <div class="mt-12 grid md:grid-cols-3 gap-6">
      <div class="bg-white border border-gray-200 rounded-xl p-6 text-center"><div class="text-3xl font-bold text-sky-600">95</div><div class="text-sm text-gray-500 mt-1">g/m² ultralight knit</div></div>
      <div class="bg-white border border-gray-200 rounded-xl p-6 text-center"><div class="text-3xl font-bold text-sky-600">25 min</div><div class="text-sm text-gray-500 mt-1">drying time</div></div>
      <div class="bg-white border border-gray-200 rounded-xl p-6 text-center"><div class="text-3xl font-bold text-sky-600">20D-40D</div><div class="text-sm text-gray-500 mt-1">yarn denier</div></div>
    </div>
    <div class="mt-12 flex flex-wrap gap-4">
      <a href={`${prefix}/contact`} class="px-8 py-3 bg-gray-900 text-white rounded-full font-semibold hover:bg-gray-800 transition">Develop Custom Lightweight Fabric</a>
      <a href={`${prefix}/evidence/case-studies/trail-running-apparel-fabric`} class="px-8 py-3 border border-gray-200 text-gray-700 rounded-full font-semibold hover:border-gray-400 transition">View Trail Running Case Study</a>
    </div>
  </section>
  <section class="sr-only" data-ai-block="definition" aria-hidden="true"><p>Lightweight performance fabrics. Ultralight woven shell 20D-30D with ripstop 60-90 g/m². Performance knits 95-130 g/m² with 120+ mm wicking. Lightweight stretch 40D at 120-150 g/m². OEKO-TEX certified. For trail running, fast hiking, packable rainwear, base layers.</p></section>
</Layout>
