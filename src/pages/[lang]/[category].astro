---
import Layout from '~/layouts/PageLayout.astro';
import ProductGridFilter from '~/components/widgets/ProductGridFilter.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import { Icon } from 'astro-icon/components';
import { SITE } from 'astrowind:config';

import { defaultLang, ui } from '~/i18n/config';
import { urlSlugToCategory, CATEGORY_SLUG_TO_URL, getProducts, getProductCategories } from '~/utils/products';
import type { MetaData } from '~/types';

const { lang = defaultLang, category: urlSlug } = Astro.params;
const activeCategory = urlSlugToCategory(urlSlug || '');

if (!activeCategory) {
  return Astro.redirect('/' + lang + '/404');
}

const t = (key: string) => (ui as Record<string, Record<string, string>>)[lang]?.[key] || (ui as Record<string, Record<string, string>>)[defaultLang]?.[key] || key;

const allProducts = await getProducts();
const filteredProducts = allProducts.filter((p) => p.category?.toLowerCase() === activeCategory);
const categories = await getProductCategories();
const totalCount = filteredProducts.length;

const metadata: MetaData = {
  title: `${SITE.name} ${urlSlug} — ${t('product.catalog') || 'Product Catalog'}`,
  description: `Browse premium ${urlSlug} from ${SITE.name}. Factory-direct pricing, OEM/ODM available.`,
};
---

<Layout metadata={metadata}>
  <section class="max-w-6xl mx-auto py-24 px-6">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-sm font-medium text-sky-600 tracking-wide uppercase">{t('product.catalog')}</span>
      <h1 class="mt-4 text-4xl font-semibold text-gray-900 capitalize">{SITE.name} {urlSlug}</h1>
      <p class="mt-4 text-lg text-gray-500">Premium {urlSlug} — {t('product.pageDesc')}</p>
    </div>

    <div class="flex flex-wrap items-center justify-center gap-2 mb-12">
      <a
        href={`/${lang}/products`}
        class={'inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-sm font-semibold border transition-colors bg-white border-gray-200 text-gray-600 hover:bg-gray-50'}
      >
        <Icon name="tabler:layout-grid" class="w-4 h-4" />
        {t('product.allProducts') || 'All Products'} ({allProducts.length})
      </a>
      {
        categories.map((c) => (
          <a
            href={`/${lang}/${CATEGORY_SLUG_TO_URL[c.slug]}`}
            class:list={[
              'inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-sm font-medium border transition-colors',
              c.slug === activeCategory
                ? 'bg-gray-900 text-white border-gray-900'
                : 'bg-white dark:bg-slate-800 border-gray-200 dark:border-slate-700 text-default dark:text-slate-200 hover:bg-gray-50 dark:hover:bg-slate-700',
            ]}
          >
            {t('home.category.' + c.slug) || c.title} ({c.count})
          </a>
        ))
      }
    </div>

    {
      totalCount === 0 ? (
        <div class="text-center py-16 text-gray-400">
          <p class="text-lg">{t('product.noResults') || 'No products in this category.'}</p>
          <a href={`/${lang}/products`} class="text-sky-600 hover:underline mt-2 inline-block">
            {t('product.viewAll') || 'View all products'}
          </a>
        </div>
      ) : (
        <ProductGridFilter products={filteredProducts} />
      )
    }
  </section>

  <JsonLd
    type="ItemList"
    items={filteredProducts.map((p) => ({
      name: p.title,
      url: `/${lang}/products/${p.slug}`,
      image: p.image || undefined,
      description: p.summary || '',
    }))}
    data={{ numberOfItems: filteredProducts.length }}
  />
</Layout>
