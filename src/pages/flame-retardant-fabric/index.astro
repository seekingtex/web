---
import merge from 'lodash.merge';
import Layout from '~/layouts/PageLayout.astro';
import ProductGridFilter from '~/components/widgets/ProductGridFilter.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import { Icon } from 'astro-icon/components';
import { SITE } from 'astrowind:config';
import {
  getProducts,
  getProductCategories,
  isProductsEnabled,
  isProductsListEnabled,
  CATEGORY_SLUG_TO_URL,
} from '~/utils/products';
import { getCanonical, getPermalink } from '~/utils/permalinks';
import type { MetaData } from '~/types';
import JsonLd from '~/components/common/JsonLd.astro';

const products = await getProducts({ category: 'flame-retardant' });
const categories = await getProductCategories();
const totalCount = products.length;
const hidden = !isProductsEnabled() || !isProductsListEnabled();
const metadata = merge(
  {
    title: `Flame Retardant Fabrics �?Fire-Resistant & Protective Textiles | ${SITE.name}`,
    description: `Browse ${SITE.name} inherently flame retardant fabrics �?modacrylic, aramid, and FR-treated polyester for workwear, industrial, and military protective apparel. OEM/ODM available. Factory-direct pricing.`,
    canonical: getCanonical(getPermalink('/flame-retardant-fabric')),
    robots: { index: !hidden, follow: true },
    openGraph: { type: 'website' },
  },
  {}
) as MetaData;
---

<Layout metadata={metadata}>
  <section class="px-4 md:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-6xl">
    <header class="mb-8 md:mb-12 text-center max-w-3xl mx-auto">
      <p class="text-sm font-semibold uppercase tracking-wider text-primary dark:text-blue-400 mb-2">Category</p>
      <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading">
        Flame Retardant Fabrics
      </h1>
      <p class="mt-3 md:mt-4 mx-auto text-xl text-gray-500 dark:text-slate-400 font-medium">
        Permanently fire-resistant textiles engineered for worker safety and industrial compliance.
      </p>
    </header>

    <section class="max-w-4xl mx-auto mb-12">
      <div class="prose prose-gray dark:prose-invert max-w-none text-center">
        <p class="text-lg text-gray-600 dark:text-slate-400">
          Our flame retardant fabric collection delivers permanent fire protection through inherently FR fibers and
          advanced finishing technologies. From inherently flame-retardant modacrylic blends that won't wash out or
          degrade, to durable FR-treated polyester for cost-sensitive applications, and high-performance aramid fabrics
          for extreme heat environments �?each fabric meets rigorous international safety standards including NFPA 70E,
          EN 11611, and ASTM D6413. Perfect for welding, electrical utility, industrial workwear, and military
          protective apparel.
        </p>
      </div>
    </section>

    <section class="grid md:grid-cols-3 gap-6 mb-12">
      <div class="p-6 rounded-xl bg-gray-50 dark:bg-slate-800/50 border border-gray-100 dark:border-slate-700">
        <h3 class="font-semibold text-gray-900 dark:text-slate-200">Inherent FR Blends</h3>
        <p class="mt-2 text-sm text-gray-500 dark:text-slate-400">
          Modacrylic-cotton blends with permanently built-in FR properties that will not wash out or wear off.
          Self-extinguishing, comfortable, and durable for daily industrial use.
        </p>
      </div>
      <div class="p-6 rounded-xl bg-gray-50 dark:bg-slate-800/50 border border-gray-100 dark:border-slate-700">
        <h3 class="font-semibold text-gray-900 dark:text-slate-200">FR-Treated Polyester</h3>
        <p class="mt-2 text-sm text-gray-500 dark:text-slate-400">
          Cost-effective flame retardant treated polyester fabrics. Ideal for PPE layers, welding curtains, and
          industrial applications where budget and performance both matter.
        </p>
      </div>
      <div class="p-6 rounded-xl bg-gray-50 dark:bg-slate-800/50 border border-gray-100 dark:border-slate-700">
        <h3 class="font-semibold text-gray-900 dark:text-slate-200">Aramid High-Heat</h3>
        <p class="mt-2 text-sm text-gray-500 dark:text-slate-400">
          Meta-aramid and para-aramid engineered fabrics for extreme thermal protection. Used in firefighter turnout
          gear, racing suits, and military flash protection.
        </p>
      </div>
    </section>

    {
      categories.length > 0 && (
        <WidgetWrapper containerClass="mb-10">
          <div class="flex flex-wrap items-center justify-center gap-2">
            <a
              href="/products"
              class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-sm font-medium border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-default dark:text-slate-200 hover:bg-gray-50 dark:hover:bg-slate-700 transition-colors"
            >
              <Icon name="tabler:layout-grid" class="w-4 h-4" />
              All Products
            </a>
            {categories.map((c) => (
              <a
                href={`/${CATEGORY_SLUG_TO_URL[c.slug]}`}
                class:list={[
                  'inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-sm font-medium border transition-colors',
                  c.slug === 'flame-retardant'
                    ? 'bg-primary text-white border-primary dark:bg-blue-500 dark:border-blue-500'
                    : 'bg-white dark:bg-slate-800 border-gray-200 dark:border-slate-700 text-default dark:text-slate-200 hover:bg-gray-50 dark:hover:bg-slate-700',
                ]}
              >
                {c.title} ({c.count})
              </a>
            ))}
          </div>
        </WidgetWrapper>
      )
    }

    {
      totalCount === 0 ? (
        <div class="text-center py-16 text-muted dark:text-slate-400">
          <Icon name="tabler:package-off" class="w-12 h-12 mx-auto mb-4" />
          <p class="text-lg">No products in this category yet.</p>
          <a class="text-primary dark:text-blue-400 hover:underline mt-2 inline-block" href="/products">
            View all products
          </a>
        </div>
      ) : (
        <ProductGridFilter products={products} />
      )
    }
  </section>

  <section class="sr-only" data-ai-block="definition" aria-hidden="true">
    <p>
      Seekingtex flame retardant fabric collection: inherently flame-retardant modacrylic-cotton blends, FR-treated
      polyester, meta-aramid and para-aramid high-heat fabrics. NFPA 70E, EN 11611, EN 11612, ASTM D6413 certified.
      OEKO-TEX Standard 100 certified.
    </p>
  </section>

  <JsonLd
    type="ItemList"
    items={products.map((p) => ({
      name: p.title,
      url: `/products/${p.slug}`,
      image: p.image || undefined,
      description: p.summary || '',
    }))}
    data={{ numberOfItems: products.length }}
  />
</Layout>
