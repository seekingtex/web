---
import merge from 'lodash.merge';
import Layout from '~/layouts/PageLayout.astro';
import ProductGridFilter from '~/components/widgets/ProductGridFilter.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import { Icon } from 'astro-icon/components';
import { SITE } from 'astrowind:config';
import {
  getProducts,
  getProductCategories,
  isProductsEnabled,
  isProductsListEnabled,
  CATEGORY_SLUG_TO_URL,
} from '~/utils/products';
import { getCanonical, getPermalink } from '~/utils/permalinks';
import type { MetaData } from '~/types';
import JsonLd from '~/components/common/JsonLd.astro';

const products = await getProducts({ category: 'eco-friendly' });
const categories = await getProductCategories();
const totalCount = products.length;
const hidden = !isProductsEnabled() || !isProductsListEnabled();
const metadata = merge(
  {
    title: `Eco-Friendly Fabrics —Recycled & Sustainable Performance Textiles | ${SITE.name}`,
    description: `Browse ${SITE.name} eco-friendly recycled fabrics —GRS-certified post-consumer PET, organic cotton, and biodegradable PLA performance textiles. OEM/ODM available. Factory-direct pricing.`,
    canonical: getCanonical(getPermalink('/eco-friendly-fabric')),
    robots: { index: !hidden, follow: true },
    openGraph: { type: 'website' },
  },
  {}
) as MetaData;
---

<Layout metadata={metadata}>
  <section class="px-4 md:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-6xl">
    <header class="mb-8 md:mb-12 text-center max-w-3xl mx-auto">
      <p class="text-sm font-semibold uppercase tracking-wider text-primary dark:text-blue-400 mb-2">Category</p>
      <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading">Eco-Friendly Fabrics</h1>
      <p class="mt-3 md:mt-4 mx-auto text-xl text-gray-500 dark:text-slate-400 font-medium">
        Sustainable performance textiles —recycled, organic, and biodegradable materials without compromise.
      </p>
    </header>

    <section class="max-w-4xl mx-auto mb-12">
      <div class="prose prose-gray dark:prose-invert max-w-none text-center">
        <p class="text-lg text-gray-600 dark:text-slate-400">
          Our eco-friendly fabric collection proves that sustainability and performance go hand in hand. From
          GRS-certified 100% post-consumer recycled PET polyester that matches virgin quality in strength and dye
          consistency, to GOTS-certified organic cotton grown without synthetic pesticides, and compostable PLA
          (polylactic acid) derived from renewable corn starch —each fabric is third-party certified and fully
          traceable. Perfect for brands building a circular economy product line.
        </p>
      </div>
    </section>

    <section class="grid md:grid-cols-3 gap-6 mb-12">
      <div class="p-6 rounded-xl bg-gray-50 dark:bg-slate-800/50 border border-gray-100 dark:border-slate-700">
        <h3 class="font-semibold text-gray-900 dark:text-slate-200">Recycled PET Polyester</h3>
        <p class="mt-2 text-sm text-gray-500 dark:text-slate-400">
          GRS-certified 100% post-consumer recycled polyester. Bottle-to-fabric traceability. Identical performance to
          virgin polyester in strength, color, and durability. Available in woven and knit constructions.
        </p>
      </div>
      <div class="p-6 rounded-xl bg-gray-50 dark:bg-slate-800/50 border border-gray-100 dark:border-slate-700">
        <h3 class="font-semibold text-gray-900 dark:text-slate-200">Organic Cotton</h3>
        <p class="mt-2 text-sm text-gray-500 dark:text-slate-400">
          GOTS-certified organic cotton grown without synthetic pesticides or fertilizers. Non-GMO seeds, natural
          farming methods, and fair-trade certified supply chain.
        </p>
      </div>
      <div class="p-6 rounded-xl bg-gray-50 dark:bg-slate-800/50 border border-gray-100 dark:border-slate-700">
        <h3 class="font-semibold text-gray-900 dark:text-slate-200">Biodegradable PLA</h3>
        <p class="mt-2 text-sm text-gray-500 dark:text-slate-400">
          Corn-starch derived PLA (polylactic acid) fiber. Industrially compostable with performance properties similar
          to polyester. Ideal for disposable or short-lifecycle textile products.
        </p>
      </div>
    </section>

    {
      categories.length > 0 && (
        <WidgetWrapper containerClass="mb-10">
          <div class="flex flex-wrap items-center justify-center gap-2">
            <a
              href="/products"
              class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-sm font-medium border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-default dark:text-slate-200 hover:bg-gray-50 dark:hover:bg-slate-700 transition-colors"
            >
              <Icon name="tabler:layout-grid" class="w-4 h-4" />
              All Products
            </a>
            {categories.map((c) => (
              <a
                href={`/${CATEGORY_SLUG_TO_URL[c.slug]}`}
                class:list={[
                  'inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-sm font-medium border transition-colors',
                  c.slug === 'eco-friendly'
                    ? 'bg-primary text-white border-primary dark:bg-blue-500 dark:border-blue-500'
                    : 'bg-white dark:bg-slate-800 border-gray-200 dark:border-slate-700 text-default dark:text-slate-200 hover:bg-gray-50 dark:hover:bg-slate-700',
                ]}
              >
                {c.title} ({c.count})
              </a>
            ))}
          </div>
        </WidgetWrapper>
      )
    }

    {
      totalCount === 0 ? (
        <div class="text-center py-16 text-muted dark:text-slate-400">
          <Icon name="tabler:package-off" class="w-12 h-12 mx-auto mb-4" />
          <p class="text-lg">No products in this category yet.</p>
          <a class="text-primary dark:text-blue-400 hover:underline mt-2 inline-block" href="/products">
            View all products
          </a>
        </div>
      ) : (
        <ProductGridFilter products={products} />
      )
    }
  </section>

  <section class="sr-only" data-ai-block="definition" aria-hidden="true">
    <p>
      Seekingtex eco-friendly fabric collection: GRS-certified 100% post-consumer recycled PET polyester, GOTS-certified
      organic cotton, industrially compostable PLA (polylactic acid) fiber. Full traceability and third-party
      certification available. OEKO-TEX Standard 100 certified.
    </p>
  </section>

  <JsonLd
    type="ItemList"
    items={products.map((p) => ({
      name: p.title,
      url: `/products/${p.slug}`,
      image: p.image || undefined,
      description: p.summary || '',
    }))}
    data={{ numberOfItems: products.length }}
  />
</Layout>
