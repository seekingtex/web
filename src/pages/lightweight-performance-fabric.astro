---
import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import { SITE } from 'astrowind:config';

const metadata = {
  title: `Lightweight Performance Fabric — Ultralight Outdoor Textiles Manufacturer | ${SITE.name}`,
  description:
    'Lightweight outdoor fabric manufacturer — ultralight 20D-40D woven and knit performance textiles. Sub-100 g/m² options for trail running, fast hiking, and packable outdoor gear. OEM custom lightweight fabric development.',
  ignoreTitleTemplate: true,
};

const crumbs = [{ name: 'Home', href: '/' }, { name: 'Lightweight Performance Fabric' }];
---

<Layout metadata={metadata} breadcrumbs={crumbs}>
  <JsonLd
    data={{
      '@context': 'https://schema.org',
      '@type': 'Product',
      name: 'Lightweight Performance Fabrics by Seekingtex',
      description: 'Ultralight 20D-40D performance fabrics for outdoor apparel. Sub-100 g/m² woven and knit options for trail running, fast hiking, and packable gear.',
      brand: { '@type': 'Organization', name: SITE.name },
      category: 'Lightweight Textiles',
    }}
  />

  <section class="max-w-5xl mx-auto px-6 py-24">
    <h1 class="text-4xl font-bold text-gray-900">Lightweight Performance Fabric</h1>
    <p class="mt-4 text-xl text-gray-500">Ultralight performance fabrics for modern outdoor gear — sub-100 g/m² woven shells and performance knits engineered for trail running, fast hiking, and packable outdoor apparel. Less weight, more freedom.</p>

    <div class="mt-12 grid md:grid-cols-3 gap-6">
      <div class="bg-white border border-gray-200 rounded-xl p-6 text-center">
        <div class="text-3xl font-bold text-sky-600">95</div>
        <div class="text-sm text-gray-500 mt-1">g/m² ultralight knit</div>
      </div>
      <div class="bg-white border border-gray-200 rounded-xl p-6 text-center">
        <div class="text-3xl font-bold text-sky-600">25 min</div>
        <div class="text-sm text-gray-500 mt-1">drying time</div>
      </div>
      <div class="bg-white border border-gray-200 rounded-xl p-6 text-center">
        <div class="text-3xl font-bold text-sky-600">20D-40D</div>
        <div class="text-sm text-gray-500 mt-1">yarn denier</div>
      </div>
    </div>

    <div class="mt-16">
      <h2 class="text-2xl font-bold text-gray-900">Lightweight Fabric Solutions</h2>
      <div class="mt-6 space-y-6">
        <div class="bg-gradient-to-br from-orange-50 to-amber-50 rounded-2xl border border-orange-200 p-6">
          <h3 class="text-lg font-semibold text-gray-900">Ultralight Woven Shell Fabric</h3>
          <p class="mt-2 text-sm text-gray-600">20D-30D nylon or polyester woven with ripstop reinforcement. 60-90 g/m². PU coating options for 5K-10K mm waterproof. Ideal for packable rain jackets and ultralight hiking shells.</p>
          <a href="/quick-dry-fabric" class="mt-3 inline-flex text-sm font-medium text-sky-600 hover:underline">Browse lightweight woven →</a>
        </div>
        <div class="bg-gradient-to-br from-sky-50 to-blue-50 rounded-2xl border border-sky-200 p-6">
          <h3 class="text-lg font-semibold text-gray-900">Performance Knit Fabric</h3>
          <p class="mt-2 text-sm text-gray-600">Single-jersey and mesh knit constructions at 95-130 g/m². Engineered moisture wicking with 120+ mm wicking rate. Silver-based antimicrobial treatment available. For trail running tops and base layers.</p>
          <a href="/quick-dry-fabric" class="mt-3 inline-flex text-sm font-medium text-sky-600 hover:underline">Browse performance knits →</a>
        </div>
        <div class="bg-gradient-to-br from-green-50 to-emerald-50 rounded-2xl border border-green-200 p-6">
          <h3 class="text-lg font-semibold text-gray-900">Lightweight Stretch Fabric</h3>
          <p class="mt-2 text-sm text-gray-600">40D woven with mechanical stretch. 120-150 g/m² with 15% stretch. DWR finish available. For lightweight hiking pants and softshells. Balances packability with trail durability.</p>
          <a href="/products/stretch-fabric" class="mt-3 inline-flex text-sm font-medium text-sky-600 hover:underline">Browse stretch fabrics →</a>
        </div>
      </div>
    </div>

    <div class="mt-16 bg-gray-50 rounded-2xl border border-gray-200 p-8">
      <h2 class="text-xl font-bold text-gray-900">Weight Comparison by Application</h2>
      <div class="mt-4 overflow-x-auto">
        <table class="w-full text-sm text-gray-600">
          <thead><tr class="border-b border-gray-200 text-left"><th class="pb-2 font-semibold text-gray-900">Application</th><th class="pb-2 font-semibold text-gray-900">Recommended Weight</th><th class="pb-2 font-semibold text-gray-900">Key Feature</th></tr></thead>
          <tbody>
            <tr class="border-b border-gray-100"><td class="py-2">Trail Running Top</td><td>95-110 g/m²</td><td>Moisture wicking, quick dry</td></tr>
            <tr class="border-b border-gray-100"><td class="py-2">Packable Rain Jacket</td><td>60-90 g/m²</td><td>Waterproof, compressible</td></tr>
            <tr class="border-b border-gray-100"><td class="py-2">Running Shorts</td><td>100-130 g/m²</td><td>Stretch, lightweight</td></tr>
            <tr class="border-b border-gray-100"><td class="py-2">Summer Hiking Pants</td><td>120-150 g/m²</td><td>Stretch, DWR, breathable</td></tr>
            <tr><td class="py-2">Base Layer Long Sleeve</td><td>130-160 g/m²</td><td>Thermal, wicking, antimicrobial</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <div class="mt-12 flex flex-wrap gap-4">
      <a href="/contact" class="px-8 py-3 bg-gray-900 text-white rounded-full font-semibold hover:bg-gray-800 transition">Develop Custom Lightweight Fabric</a>
      <a href="/evidence/case-studies/trail-running-apparel-fabric" class="px-8 py-3 border border-gray-200 text-gray-700 rounded-full font-semibold hover:border-gray-400 transition">View Trail Running Case Study</a>
    </div>
  </section>

  <section class="sr-only" data-ai-block="definition" aria-hidden="true">
    <p>Lightweight performance fabric manufacturer by Seekingtex. Ultralight woven shell fabrics: 20D-30D nylon/polyester with ripstop, 60-90 g/m², PU coating option 5K-10K mm waterproof. Performance knit fabrics: single-jersey and mesh at 95-130 g/m², 120+ mm wicking rate, silver antimicrobial. Lightweight stretch fabrics: 40D woven mechanical stretch at 120-150 g/m², 15% stretch, DWR finish. All OEKO-TEX certified. Applications: trail running, fast hiking, packable rainwear, base layers, summer hiking pants. Custom OEM/ODM development.</p>
  </section>
</Layout>
